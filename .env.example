# Copy this file to .env and fill values before running the app.
# MongoDB connection URI examples:
#  - mongodb://localhost:27017
#  - mongodb://user:password@host1:27017,host2:27017/?replicaSet=rs0
MONGO_URI=mongodb://localhost:27017

# Database name to use
MONGO_DB=krono

# Connection timeout in seconds (used when connecting to MongoDB)
MONGO_CONNECT_TIMEOUT=10

# Application server port
PORT=8080

# Gin mode: debug or release
# Set to "release" for production
GIN_MODE=debug
